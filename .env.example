# Eclipse AI — example configuration.
# Copy to ".env" and fill in your own values. NEVER commit the real .env file.

# FalkorDB connection (required)
FALKORDB_HOST=falkordb.example.internal
FALKORDB_PORT=54211
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=change-me
FALKORDB_GRAPH=eclipse-ai

# Present in local environments for documentation purposes only.
# NOTE: the current code opens FalkorDB connections with ssl=False hardcoded
# in app.py (get_graph); this key is not read by the application yet.
FALKORDB_TLS=false

# Emergency kill switch for the independent safety policy.
# Any of: 1, true, yes, on  -> every agent action is blocked before execution.
ECLIPSE_KILL_SWITCH=false
